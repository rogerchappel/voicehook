{
  "name": "voicehook",
  "version": "0.1.0",
  "description": "Local-first safe voice-command hooks for transcripts, inbox capture, and agent workflows.",
  "type": "module",
  "bin": {
    "voicehook": "./dist/src/cli.js"
  },
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "files": [
    "dist/src",
    "fixtures",
    "examples",
    "README.md",
    "SECURITY.md",
    "LICENSE",
    "CHANGELOG.md",
    "CONTRIBUTING.md"
  ],
  "scripts": {
    "check": "tsc --noEmit",
    "build": "tsc -p tsconfig.json && node scripts/make-cli-executable.mjs",
    "test": "npm run build --silent && node --test dist/test/*.test.js",
    "smoke": "npm run build --silent && node dist/src/cli.js ingest --config fixtures/voicehook.config.json --transcript fixtures/transcripts/demo.jsonl --dry-run --json",
    "package:smoke": "node scripts/assert-package-surface.mjs",
    "release:workflow": "node scripts/assert-release-workflow.mjs",
    "release:check": "npm run check && npm test && npm run smoke && npm run package:smoke && npm run release:workflow"
  },
  "keywords": [
    "voice",
    "cli",
    "local-first",
    "transcript",
    "openclaw",
    "crewcmd",
    "automation",
    "privacy",
    "wake-phrase"
  ],
  "author": "Roger Chappel",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rogerchappel/voicehook.git"
  },
  "bugs": {
    "url": "https://github.com/rogerchappel/voicehook/issues"
  },
  "homepage": "https://github.com/rogerchappel/voicehook#readme"
}
